  "version": "0.2.0",
  "configurations": [
    {
      "name": "Command Crawl",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "showLog": true,
      "debugAdapter": "dlv-dap",
      "program": "${workspaceRoot}/cmd",
      "args": ["crawl_javbus", "javbus_code", "--magnet", "TKD-048"],
      "output": "${workspaceRoot}/build/garage",
      "trace": "verbose",
      "cwd": "${workspaceRoot}"
    },
    {
      "name": "Command Javbus Star Crawl",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "showLog": true,
      "debugAdapter": "dlv-dap",
      "program": "${workspaceRoot}/cmd",
      "args": ["crawl_javbus", "javbus_star_code", "--magnet"],
      "output": "${workspaceRoot}/build/garage",
      "trace": "verbose",
      "cwd": "${workspaceRoot}"
    },
    {
      "name": "Command Server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "showLog": true,
      "debugAdapter": "dlv-dap",
      "program": "${workspaceRoot}/garage_server",
      "args": [],
      "output": "${workspaceRoot}/build/garage_server",
      "envFile": "${workspaceFolder}/.dev.env",
      "trace": "verbose",
      "cwd": "${workspaceRoot}"
    }
  ]
}
